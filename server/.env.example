# Configurações do Servidor
PORT=3001
HOST=0.0.0.0

# Provedor de IA: "gemini", "openai", "typesafe", ou "mock"
AI_PROVIDER=gemini

# Google Gemini (Recomendado para visão de símbolos e imagens psicotécnicas)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-2.5-flash

# OpenAI ou compatível (Opcional)
# AI_PROVIDER=openai
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sua_chave_openai_aqui

# Timeout da chamada à IA (ms)
AI_TIMEOUT_MS=30000

# CORS (Permitir acesso da extensão e da app Android)
CORS_ORIGINS=*
