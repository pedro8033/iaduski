# Configurações do Servidor
PORT=3001
HOST=0.0.0.0

# Provedor de IA: "agentrouter", "gemini", "openrouter", "openai", "typesafe", ou "mock"
AI_PROVIDER=agentrouter

# AgentRouter (https://agentrouter.org/docs/index.html)
# Modelos suportados: claude-opus-4-8, claude-opus-5, deepseek-v4-flash, gpt-6-astra
AGENTROUTER_API_KEY=sua_chave_agentrouter_aqui
AGENTROUTER_MODEL=claude-opus-4-8
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Google Gemini (AI Studio)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI ou compatível (Opcional)
# AI_PROVIDER=openai
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sua_chave_openai_aqui

# Timeout da chamada à IA (ms)
AI_TIMEOUT_MS=30000

# CORS (Permitir acesso da extensão e da app Android)
CORS_ORIGINS=*

# ========================================================
# BANCO DE DADOS & AUTENTICAÇÃO: SUPABASE (https://supabase.com)
# ========================================================
# Obtenha estas chaves em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui
# Opcional (usada pelo backend para bypass de RLS quando necessário):
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta_aqui

